{
  "manifest_version": 3,
  "name": "Jira to ChatGPT",
  "description": "Send Jira issues to ChatGPT with one click",
  "version": "1.0.0",
  "icons": {
    "128": "icon-128.png"
  },
  "host_permissions": [
    "*://*.atlassian.net/*"
  ],
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "src/pages/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.atlassian.net/browse/*"],
      "js": ["src/pages/jira-to-gpt/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon-128.png",
        "icon-32.png"
      ],
      "matches": []
    }
  ]
}